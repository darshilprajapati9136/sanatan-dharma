# ---------------------------------------------------------------------------
# Sanatan Dharma platform — environment template
# Copy to .env.local and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Sanatan Dharma
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Feature flags ----------------------------------------------------------
# Ask Dharma (AI) is deferred to Phase 5. Keep disabled.
NEXT_PUBLIC_FEATURE_ASK_DHARMA=false

# --- Supabase (Phase 1) -----------------------------------------------------
# Create a project at https://supabase.com and copy the project URL + publishable key.
# Enable Email + Google OAuth providers in Authentication → Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias for the publishable key (deprecated, still accepted by the app).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for admin scripts. Never prefix with NEXT_PUBLIC_ and never
# commit a real value. Never use it in frontend or client-side code.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection string used by Drizzle migrations / server.
# Server-only: never prefix with NEXT_PUBLIC_ and never expose to the browser.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- AI provider (Phase 5) — placeholder -------------------------------------
AI_API_KEY=
# RAG stays OFF unless this is exactly "true" (see src/server/services/rag-gate.ts).
RAG_ENABLED=false

# --- Panchang provider (Prokerala, server-only) -------------------------------
# Live Panchang is used only when BOTH are set; otherwise the app honestly
# serves the labelled sample fixture. Get credentials at https://www.prokerala.com/.
PROKERALA_CLIENT_ID=
PROKERALA_CLIENT_SECRET=