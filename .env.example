# ---------------------------------------------------------------------------
# Sanatan Dharma platform — environment template
# Copy to .env.local and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Sanatan Dharma
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Feature flags ----------------------------------------------------------
# Ask Dharma (AI) is deferred to Phase 5. Keep disabled.
NEXT_PUBLIC_FEATURE_ASK_DHARMA=false

# --- Supabase (Phase 1) -----------------------------------------------------
# Create a project at https://supabase.com and copy the project URL + anon key.
# Enable Email + Google OAuth providers in Authentication → Providers.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# PostgreSQL connection string used by Drizzle migrations / server.
# Example: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- AI provider (Phase 5) — placeholder -------------------------------------
AI_API_KEY=